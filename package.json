{
  "name": "enterprise-diagnosis-agent",
  "version": "0.0.1",
  "private": true,
  "description": "企业诊断智能体 - Clean-Room Rebuild",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke:mock": "cross-env DIAGNOSIS_SMOKE_MODE=true tsx scripts/smoke-mock.ts",
    "security:check": "tsx scripts/security-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/storage/migrate.ts"
  },
  "dependencies": {
    "next": "15.5.20",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.2",
    "drizzle-orm": "0.38.4",
    "better-sqlite3": "11.8.1",
    "cheerio": "1.0.0",
    "p-limit": "6.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@next/eslint-plugin-next": "15.5.20",
    "@playwright/test": "1.50.1",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.13.1",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "cross-env": "7.0.3",
    "drizzle-kit": "0.30.4",
    "eslint": "9.19.0",
    "eslint-config-next": "15.5.20",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react": "7.37.4",
    "tailwindcss": "3.4.17",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
