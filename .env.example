# Copy to .env and fill in real values locally. Never commit .env.

# --- Bocha (web search) ---
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1/web-search

# --- DeepSeek (structured analysis) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Storage ---
DATABASE_URL=./data/dev.sqlite

# --- Runtime mode ---
# Must be explicitly set to "false" at process level before any real-sample run.
DIAGNOSIS_SMOKE_MODE=true

# --- Budget overrides (all optional, defaults defined in src/runtime/budget.ts) ---
BUDGET_MAX_BOCHA_CALLS=120
BUDGET_MAX_DEEPSEEK_CALLS=30
BUDGET_MAX_RETRIES=18
BUDGET_MAX_WALLCLOCK_MS=1200000
BUDGET_MAX_EVIDENCE_COUNT=300
BUDGET_MAX_STAGE_INPUT_TOKENS=20000
